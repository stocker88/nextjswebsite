# Server-only values; never use NEXT_PUBLIC_ prefixes.
OPTIONS_BACKEND_URL=https://us-central1-stocker-fcda2.cloudfunctions.net/optionsSnapshots
OPTIONS_BACKEND_TOKEN=
# Enable only after appropriate public redistribution/display rights are confirmed.
OPTIONS_DISPLAY_LICENSE_CONFIRMED=false
# Local development only; ignored when NODE_ENV=production.
OPTIONS_PRIVATE_PREVIEW=false
# MASSIVE_API_KEY belongs to Firebase Secret Manager, not the website runtime.
