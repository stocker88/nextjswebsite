{
  "hosting": {
    "target": "website",
    "public": "hosting-empty",
    "ignore": [
      "firebase.json",
      "**/.gitkeep",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cache-Control", "value": "public, max-age=300" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "stocker-website",
          "region": "us-central1",
          "pinTag": true
        }
      }
    ]
  }
}
