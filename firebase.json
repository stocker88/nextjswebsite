{
  "hosting": {
    "target": "website",
    "public": "hosting-empty",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "stocker-website",
          "region": "us-central1",
          "pinTag": true
        }
      }
    ]
  }
}
